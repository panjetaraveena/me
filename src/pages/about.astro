            <td class="py-2 pr-4 font-semibold text-gray-700 whitespace-nowrap align-top">Programming Languages</td>
            <td class="py-2 text-base text-gray-700">JavaScript, TypeScript, HTML, CSS, Python, C, C++.</td>
          </tr>
          <tr class="border-b">
            <td class="py-2 pr-4 font-semibold text-gray-700 whitespace-nowrap align-top">Software Frameworks</td>
            <td class="py-2 text-base text-gray-700">NodeJS, ExpressJS, GraphQL, Angular, React</td>
          </tr>
          <tr class="border-b">
            <td class="py-2 pr-4 font-semibold text-gray-700 whitespace-nowrap align-top">Databases and Backend</td>
            <td class="py-2 text-base text-gray-700">MongoDB, DynamoDB, Elasticsearch, Kafka, Temporal, NATS</td>
          </tr>
          <tr class="border-b">
            <td class="py-2 pr-4 font-semibold text-gray-700 whitespace-nowrap align-top">Cloud & DevOps</td>
            <td class="py-2 text-base text-gray-700">AWS, Docker, Kubernetes, Netlify, CI/CD (GitHub Actions, Jenkins)</td>
          </tr>
          <tr class="border-b">
            <td class="py-2 pr-4 font-semibold text-gray-700 whitespace-nowrap align-top">Observability & Monitoring</td>
            <td class="py-2 text-base text-gray-700">Coralogix, OpenTelemetry, Grafana</td>
          </tr>
          <tr class="border-b">
            <td class="py-2 pr-4 font-semibold text-gray-700 whitespace-nowrap align-top">Testing and QA</td>
            <td class="py-2 text-base text-gray-700">Unit Testing, BDD Testing, Puppeteer, Cucumber, Jest</td>
          </tr>
          <tr class="border-b">
            <td class="py-2 pr-4 font-semibold text-gray-700 whitespace-nowrap align-top">Tools and Collaboration</td>
            <td class="py-2 text-base text-gray-700">GitHub, GitLab, Jira, Confluence, Algolia, Twilio, Agora, VS Code</td>
